# PostgreSQL (e.g. Neon). Use the pooled URL for DATABASE_URL and the direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Canonical public origin. Leave unset in production to use https://www.symc.com.tr
# (verified: symc.com.tr 301 -> https://www.symc.com.tr/). Only override for staging.
# SITE_URL="https://www.symc.com.tr"

# Filesystem directory for uploaded media (served at /media/*). Must be persistent in production.
MEDIA_STORAGE_DIR="./storage/media"

# Used only by `npm run db:seed` / `npm run admin:create` to create the first admin user.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="a-long-unique-password"
# ADMIN_NAME="SYMC Admin"
